# snaffle configuration — copy to `.env` and fill in.
# Any value of the form op://vault/item/field is resolved at runtime via the
# 1Password CLI (`op`). Never put real secrets in this file.

# --- Contact emails (polite-pool API access) ---
SNAFFLE_UNPAYWALL_EMAIL=you@example.com
SNAFFLE_CROSSREF_MAILTO=you@example.com

# --- Kagi (used to DISCOVER full-text copies and institutional repositories) ---
# The 1Password item name may contain spaces; the whole op:// reference is one
# argument, so `op read "op://Personal/Kagi API Key/password"` resolves fine.
SNAFFLE_KAGI_KEY=op://Personal/Kagi API Key/password

# --- 2Captcha (paid CAPTCHA solving; needs credit) ---
SNAFFLE_2CAPTCHA_KEY=op://Private/2captcha/api_key

# --- Institutional credentials -------------------------------------------
# Repeat this block per institution. The token between CRED_ and the suffix
# (here BIRKBECK / MSU) is the institution name; you may add as many as you
# have accounts for.
SNAFFLE_CRED_BIRKBECK_USER=your-username
SNAFFLE_CRED_BIRKBECK_PASS=op://Private/Birkbeck/password
SNAFFLE_CRED_BIRKBECK_OTP=op://Private/Birkbeck          # 1Password item holding the TOTP secret
SNAFFLE_CRED_BIRKBECK_EZPROXY=https://ezproxy.bbk.ac.uk

SNAFFLE_CRED_MSU_USER=your-netid
SNAFFLE_CRED_MSU_PASS=op://Private/MSU/password
SNAFFLE_CRED_MSU_OTP=op://Private/MSU
SNAFFLE_CRED_MSU_EZPROXY=https://proxy1.cl.msu.edu

# Repository endpoints (eprints, InvenioRDM, Pure, Digital Commons, staff
# homepages) are DISCOVERED at runtime via Kagi — they are deliberately not
# pre-specified here.

# --- Extra local plugin directory (in addition to the private dir) -------
# SNAFFLE_PLUGIN_DIR=/path/to/your/private/plugins
